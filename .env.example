# All optional for local development: without them the API uses embedded Postgres (PGlite, in .data/)
# and the offline drafter (term – definition lines). To copy these into Cloudflare: scripts/secrets.sh

# Postgres connection string (e.g. Neon). Production only; tables are created on first request.
# Every cloud feature (sync, capture, agents, twist-to-3D, server speech) needs it on the live site.
DATABASE_URL=

# AI drafting of scenes from captured text, free-form twists, and the study agent. Set one or more:
# Gemini is preferred, then Groq, then NVIDIA. All go through an OpenAI-compatible chat API.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# Optional model override. Defaults: gemini-3.8-flash / openai/gpt-oss-120b / meta/llama-3.3-70b-instruct
LLM_MODEL=

# Speech-to-text for browsers without a recogniser (the Quest browser): Groq Whisper, else Gemini.
# Uses GROQ_API_KEY / GEMINI_API_KEY above; nothing extra to set.

# Aholo Lux3D (labs.aholo3d.com, global region): twist-to-3D objects and 3D-print export.
# Also used offline by scripts/lux3d.mjs to build the prop library.
AHOLO_API_KEY=

# Public origin for pairing links and MCP URLs when behind a proxy, e.g. https://atrium.example.com
PUBLIC_BASE_URL=
