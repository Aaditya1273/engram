# All optional for local development: without them the API uses embedded Postgres (PGlite, in .data/)
# and the offline drafter (term – definition lines).

# Postgres connection string (e.g. Neon). Production only; tables are created on first request.
DATABASE_URL=

# AI drafting of scenes from captured text, and free-form twists. Set ONE of these
# (Gemini is used if both are set). Both go through an OpenAI-compatible chat API.
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Optional model override. Defaults: gemini-3.8-flash / meta/llama-3.3-70b-instruct
LLM_MODEL=

# Public origin for pairing links and MCP URLs when behind a proxy, e.g. https://atrium.example.com
PUBLIC_BASE_URL=
